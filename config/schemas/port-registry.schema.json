{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "port-registry",
  "type": "object",
  "required": ["version", "ports"],
  "properties": {
    "version": { "type": "integer" },
    "description": { "type": "string" },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "host", "port", "owner", "mutable"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "host": { "type": "string", "default": "127.0.0.1" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "owner": { "type": "string" },
          "mutable": { "const": false }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "note": "Codex: also enforce port uniqueness across items (not expressible in plain JSON Schema)."
}

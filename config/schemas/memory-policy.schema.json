{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect-ai.local/schemas/memory-policy.schema.json",
  "title": "Connect AI Memory Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mutable", "memoryRoot", "allowedSubdirs", "forbiddenWrite", "writeMode", "redact"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "mutable": { "const": false },
    "memoryRoot": { "type": "string", "minLength": 1 },
    "allowedSubdirs": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "decisions/" }
    },
    "forbiddenWrite": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "outside-vault" }
    },
    "writeMode": { "enum": ["observe", "live"] },
    "liveSubdirs": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "decisions/" }
    },
    "observeSubdirs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "redact": { "type": "boolean" }
  }
}
